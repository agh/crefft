# Ignore only what crefft's own tooling generates.
# The repository is documentation; there is no build output to exclude.

# npm documentation toolchain (package.json / package-lock.json are tracked).
node_modules/

# Python bytecode from scripts/.
__pycache__/
*.py[cod]

# Local scratch space used by `make check`.
.tmp-check/

# Site dependencies, generated assets, local previews, and delivery evidence.
/SITE-INPUTS/
/SITE-OUT/
/VALE-INPUTS/
/SITE-TASK.md
/VALE-TASK.md
/site/dist/
/site/.astro/
/site/.wrangler/
/site/.cache/
/site/.venv/
/site/test-results/
/site/.cache-*.log
/site/src/generated/
/site/public/favicon.svg
/site/public/favicon-32.png
/site/public/favicon-16.png
/site/public/favicon.ico
